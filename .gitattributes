# https://help.github.com/articles/dealing-with-line-endings/
# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.properties text
*.java text
*.xml text

# always linux
gradlew text eol=lf
*.sh text eol=lf

# always windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Test fixtures are golden files compared byte for byte against generated output.
# Without a fixed line ending they differ between a Windows and a Linux checkout, so the
# same commit passes on one machine and fails on the other.
*.expected text eol=lf
*.source text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.ico binary